    {
      "name": "Users",
      "description": "POST /users es publico (registro). El resto exige token. PUT pide payload completo; PATCH solo los campos enviados.",
      "item": [
        {
          "name": "Create (registro publico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "Publico. Sin token crea siempre User. Con token de Admin/God acepta UserRole (God solo lo asigna God). Responde 201 con Location: /users/{id}. Copia el ID en user_id.",
