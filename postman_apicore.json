              "raw": "{\n  \"Username\": \"{{new_username}}\",\n  \"Password\": \"TestPass123\",\n  \"Name\": \"QA\",\n  \"PaternalSurname\": \"Tester\",\n  \"MaternalSurname\": \"Pruebas\",\n  \"UserStatus\": \"Active\"\n}",
