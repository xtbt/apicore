# Copy this file to .env and fill in the values for your machine.
# Real environment variables override these values.

APP_HOST=localhost
APP_PORT=8000
APP_TIMEZONE=America/Tijuana

DB_HOST=localhost
DB_PORT=3306
DB_NAME=apicore
DB_USER=root
DB_PASSWORD=root

# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# It must be the same value the Python API uses, so both APIs accept the same tokens.
JWT_SECRET=
JWT_ALGORITHM=HS256
TOKEN_LIFETIME_MINUTES=60
TOKEN_MIN_REMAINING_MINUTES=10

# '*' allows any origin (fine for a classroom API); set a URL to restrict it
CORS_ALLOW_ORIGIN=*
